<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="24dp" android:background="@color/blanco">
    <TextView android:id="@+id/tituloCrear" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="Crear nota"
        android:textColor="@color/azul_marino" android:textSize="30sp"
        android:textStyle="bold" android:layout_marginTop="50dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
    <EditText android:id="@+id/notaTitulo" android:layout_width="0dp"
        android:layout_height="wrap_content" android:hint="Título"
        android:textColor="@color/texto" android:textColorHint="@color/gris"
        android:backgroundTint="@color/azul_principal" android:layout_marginTop="35dp"
        app:layout_constraintTop_toBottomOf="@id/tituloCrear"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <EditText android:id="@+id/notaContenido" android:layout_width="0dp"
        android:layout_height="180dp" android:gravity="top|start"
        android:inputType="textMultiLine" android:hint="Escribe tu nota..."
        android:textColor="@color/texto" android:textColorHint="@color/gris"
        android:backgroundTint="@color/azul_principal" android:layout_marginTop="18dp"
        app:layout_constraintTop_toBottomOf="@id/notaTitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <Button android:id="@+id/guardarNota" android:layout_width="0dp"
        android:layout_height="wrap_content" android:text="Guardar nota"
        android:backgroundTint="@color/azul_principal" android:textColor="@color/blanco"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/notaContenido"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <ProgressBar android:id="@+id/guardarCarga" android:layout_width="36dp"
        android:layout_height="36dp" android:visibility="gone"
        android:indeterminateTint="@color/azul_principal" android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/guardarNota"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <Button android:id="@+id/volverDashboard" android:layout_width="0dp"
        android:layout_height="wrap_content" android:text="Regresar"
        android:backgroundTint="@color/azul_claro" android:textColor="@color/azul_marino"
        android:layout_marginTop="70dp"
        app:layout_constraintTop_toBottomOf="@id/guardarNota"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
