<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp"
    android:background="@color/blanco">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Mis notas" android:textSize="30sp" android:textStyle="bold"
        android:textColor="@color/azul_marino" android:layout_marginTop="56dp" />
    <TextView android:id="@+id/bienvenida" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Bienvenido" android:textSize="20sp"
        android:textColor="@color/texto" android:layout_marginTop="16dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Elige qué deseas hacer hoy" android:textColor="@color/gris"
        android:textSize="16sp" android:layout_marginTop="8dp" />
    <Button android:id="@+id/irCrear" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Crear nueva nota"
        android:backgroundTint="@color/azul_principal" android:textColor="@color/blanco"
        android:layout_marginTop="35dp" />
    <Button android:id="@+id/irListado" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Ver mis notas"
        android:backgroundTint="@color/azul_principal" android:textColor="@color/blanco"
        android:layout_marginTop="14dp" />
    <Button android:id="@+id/salir" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Cerrar sesión"
        android:backgroundTint="@color/azul_claro" android:textColor="@color/azul_marino"
        android:layout_marginTop="35dp" />
</LinearLayout>
