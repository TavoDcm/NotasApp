<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/azul_claro">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">
        <TextView android:id="@+id/itemTitulo" android:layout_width="0dp"
            android:layout_height="wrap_content" android:text="Título"
            android:textSize="19sp" android:textStyle="bold"
            android:textColor="@color/azul_marino"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <TextView android:id="@+id/itemContenido" android:layout_width="0dp"
            android:layout_height="wrap_content" android:text="Contenido"
            android:textSize="15sp" android:textColor="@color/texto"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/itemTitulo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <TextView android:id="@+id/itemFecha" android:layout_width="0dp"
            android:layout_height="wrap_content" android:text="Fecha"
            android:textSize="12sp" android:textColor="@color/gris"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/itemContenido"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
